# pi-bot server 配置（全部可选）
# 用法：复制成 .env，然后 node --env-file=.env src/index.js

# 监听
PI_BOT_PORT=8787

# 数据/工作目录（agent 只能在这个目录里干活）
# PI_BOT_HOME=/path/to/pi-bot-data
# PI_BOT_WORKSPACE=/path/to/pi-bot-workspace

# 模型（留空用 pi 的默认模型）
# PI_BOT_MODEL=
PI_BOT_THINKING=medium

# 固定 token（设了就跳过配对码，服务器部署用）
# PI_BOT_TOKEN=

# 联网搜索（不配也能用）
# PI_BOT_SEARCH_URL=
# PI_BOT_SEARCH_KEY=

# 上下文预算
# PI_BOT_RESERVE_TOKENS=
# PI_BOT_KEEP_RECENT_TOKENS=

# 单轮超时（毫秒，0=不限）
PI_BOT_RUN_TIMEOUT_MS=600000
