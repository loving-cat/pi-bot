# pi-bot server 配置（全部可选）
# 用法：复制成 .env，然后 node --env-file=.env src/index.js

# 监听
PI_BOT_PORT=8787

# 数据/工作目录（agent 只能在这个目录里干活）
# PI_BOT_HOME=/path/to/pi-bot-data
# PI_BOT_WORKSPACE=/path/to/pi-bot-workspace

# 模型（留空用 pi 的默认模型）
# PI_BOT_MODEL=
PI_BOT_THINKING=medium

# 固定 token（设了就跳过配对码，服务器部署用）。
# 设了就是服务器模式：本机请求也要带 token（反向代理转发过来的请求看起来也是本机）。
# PI_BOT_TOKEN=

# 反向代理保留原始 Host 时，填你的域名（逗号分隔，不带端口）
# PI_BOT_ALLOWED_HOSTS=pi.example.com

# 本机请求免不免 token（默认：没设 PI_BOT_TOKEN 时免，设了时不免）
# PI_BOT_TRUST_LOCAL=0

# 联网搜索（不配也能用）
# PI_BOT_SEARCH_URL=
# PI_BOT_SEARCH_KEY=

# 上下文预算
# PI_BOT_RESERVE_TOKENS=
# PI_BOT_KEEP_RECENT_TOKENS=

# 单轮超时（毫秒，0=不限）
PI_BOT_RUN_TIMEOUT_MS=600000
