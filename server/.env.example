# pi-bot server 环境变量（全部可选）
# 复制成 .env 后用 `node --env-file=.env src/index.js` 启动，或直接 export

# 监听
PI_BOT_HOST=0.0.0.0
PI_BOT_PORT=8787
PI_BOT_NAME=pi-bot

# 数据/工作目录（agent 的 cwd 就是 workspace，工具只能在这里面干活）
# 默认 <repo>/data 与 <repo>/data/workspace
# PI_BOT_HOME=/path/to/pi-bot-data
# PI_BOT_WORKSPACE=/path/to/pi-bot-workspace

# 联网搜索（可选）：不配也能用，默认走搜索引擎的 HTML 端点，不需要 key。
# 想更稳就填一个正式接口，URL 里用 {q} 占位；配了 key 会带上 Authorization: Bearer
# PI_BOT_SEARCH_URL=https://api.search.brave.com/res/v1/web/search?q={q}&count=8
# PI_BOT_SEARCH_KEY=

# 上下文预算（可选）：不配就用 pi 自带默认（reserve 16384 / keepRecent 20000）。
# 每个 bot 还能在 App 里单独覆盖。
# PI_BOT_RESERVE_TOKENS=16384
# PI_BOT_KEEP_RECENT_TOKENS=20000
# PI_BOT_AUTO_COMPACT=0        # 关掉自动压缩（不推荐）

# 固定 token：设了就跳过配对码（服务器部署推荐）
# PI_BOT_TOKEN=

# 模型：留空用 pi 的默认模型；建议显式指定
# PI_BOT_MODEL=cline-pass/deepseek-v4.1-flash
PI_BOT_THINKING=medium

# 给 bot 的工具（默认 read,write,edit,ls,find,grep,bash）
# PI_BOT_TOOLS=read,ls,find,grep

# 不加载 ~/.pi/agent 下的扩展（默认加载，能拿到 team/dispatch_task 等工具）
# PI_BOT_NO_EXTENSIONS=1

# 单轮硬超时（毫秒，0=不限）
PI_BOT_RUN_TIMEOUT_MS=600000
