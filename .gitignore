# 依赖
node_modules/
server/package-lock.json
# 运行时数据（会话、消息、上传、模型探活缓存）
server/data/
# 构建产物
app/build/
app/.dart_tool/
app/.flutter-plugins-dependencies
app/windows/flutter/ephemeral/
app/android/.gradle/
app/android/app/.cxx/
app/android/local.properties
app/.idea/
app/*.iml
# 本地 JDK（打 APK 用，不随仓库走）
.jdk/

# 工具产物
*.png
!app/assets/**/*.png
!app/macos/Runner/Assets.xcassets/**/*.png
# 应用图标（生成的，不是截图）：Android 各密度 launcher 图标要进仓库
!app/android/app/src/main/res/mipmap-*/ic_launcher.png
# 仓库根目录的本地工具脚本（截图之类，跟平台绑定）
/tools/
# 但 server 下的自检脚本要进仓库（别人 clone 下来能自己跑）
!server/tools/
# 本地调试用的临时文件
.groupid
.img

# 杂项
*.log
.DS_Store
Thumbs.db
.rid

# 调试用的临时快照
.scratch/

# Windows runner 调试探针的产物（别提交）
probe.txt

# 构建产物 / 发布包（走 GitHub Release，不进仓库）
*.apk
*.zip

# 单元测试/本地跑起来产生的数据目录
/data/

# 打包产物（本地试跑用，不进仓库）
/dist/

# macOS 本机打包产物
*.dmg
*.app/
